{
	// Open this file in VS Code: File > Open Workspace from File.
	// It expects the folders set up by participants-instructions.md:
	//   $HOME/adlc-copilot-training/adlc-with-github-copilot-ticket-to-pr   (this course repo)
	//   $HOME/adlc-copilot-training/global-bank-*                            (the seven Global Bank repos)
	"folders": [
		{ "name": "course", "path": "." },
		{ "name": "global-bank-platform", "path": "../global-bank-platform" },
		{ "name": "global-bank-account", "path": "../global-bank-account" },
		{ "name": "global-bank-authentication", "path": "../global-bank-authentication" },
		{ "name": "global-bank-customer", "path": "../global-bank-customer" },
		{ "name": "global-bank-transaction", "path": "../global-bank-transaction" },
		{ "name": "global-bank-rules", "path": "../global-bank-rules" },
		{ "name": "global-bank-frontend", "path": "../global-bank-frontend" }
	],
	"settings": {
		"chat.agent.enabled": true,
		"mcp": {
			"servers": {
				// Jira and Confluence. Reads URLs and tokens from the course repo's .env.
				"atlassian": {
					"type": "stdio",
					"command": "uvx",
					"args": ["mcp-atlassian"],
					"envFile": "${workspaceFolder:course}/.env"
				},
				// Fallback only: lab tickets as GitHub issues.
				// "/x/issues" turns on the issues tools only, so Copilot cannot fork, push or open pull requests here.
				"github": {
					"type": "http",
					"url": "https://api.githubcopilot.com/mcp/x/issues"
				}
			}
		}
	}
}
