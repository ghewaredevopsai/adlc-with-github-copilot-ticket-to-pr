# Copy this file to .env in the same folder and fill it in. .env is never committed.
# The same values are used by two things:
#   1. labs/scripts/setup-lab-tickets.py, which loads the lab tickets into your Jira project
#   2. the Jira and Confluence MCP server that Copilot uses (see adlc-labs.code-workspace)

# --- Jira -------------------------------------------------------------------
# Your company Jira (Data Center / Server): the URL and a personal access token.
JIRA_URL=https://jira.example.com
JIRA_PERSONAL_TOKEN=
# Jira Cloud instead? Leave JIRA_PERSONAL_TOKEN empty and set these two:
# JIRA_USERNAME=you@example.com
# JIRA_API_TOKEN=
# A project you may create issues in. The lab tickets go here.
JIRA_PROJECT_KEY=ADLC
# Lets the MCP server see only this project.
JIRA_PROJECTS_FILTER=ADLC

# --- Confluence -------------------------------------------------------------
# Data Center / Server: the URL and a personal access token.
# Cloud: the URL ends in /wiki, and use CONFLUENCE_USERNAME + CONFLUENCE_API_TOKEN instead.
CONFLUENCE_URL=https://confluence.example.com
CONFLUENCE_PERSONAL_TOKEN=
# Confluence Cloud instead? Leave CONFLUENCE_PERSONAL_TOKEN empty and set these two:
# CONFLUENCE_USERNAME=you@example.com
# CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=ADLC
CONFLUENCE_SPACES_FILTER=ADLC

# --- What Copilot may do in Jira and Confluence ------------------------------
# The MCP server offers about 100 tools. The labs need these ten, and fewer tools make Copilot
# choose better. Adding comments is the only write to Jira; Confluence pages may be created
# and updated for the Module 8 write-back.
ENABLED_TOOLS=jira_get_issue,jira_search,jira_get_project_issues,jira_add_comment,confluence_search,confluence_get_page,confluence_get_page_children,confluence_create_page,confluence_update_page,confluence_add_comment

# --- Fallback only: GitHub issues instead of Jira ---------------------------
# The repository your lab issues go in, as owner/name, and a token that may create issues in it
# (a fine-grained personal access token with Issues: read and write).
# GITHUB_REPO=your-org/global-bank-account
# GITHUB_TOKEN=
# Only if your company runs its own GitHub server:
# GITHUB_API_URL=https://github.example.com/api/v3

# --- Only if your network needs a proxy to reach Jira and Confluence ---------
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
